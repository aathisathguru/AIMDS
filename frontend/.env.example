# Copy to .env.local to point the console at a running FastAPI backend.
# Set VITE_SITE_URL to the real HTTPS custom domain before deployment. The app
# omits canonical and absolute social URLs until this value is configured.
#
# Leave VITE_USE_MOCK unset (or "true") and the app runs entirely on its
# built-in fixtures — no backend required. This is the default and is what
# the standalone HTML build ships with.

# Public origin used for canonical URLs, Open Graph, JSON-LD and sitemap builds.
VITE_SITE_URL=

# Set to false to make src/services/api.js issue real HTTP requests.
VITE_USE_MOCK=false

# Where those requests go. The default "/api" is same-origin and is proxied
# to http://localhost:8000 by the Vite dev server (see vite.config.js).
# Override only if the backend is on another host.
VITE_API_BASE_URL=/api
VITE_TELEMETRY_DEVICE_ID=VELXIO-ESP32-01

# Google OAuth 2.0 Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
