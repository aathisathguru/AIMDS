# Supabase project URL and server-only service-role key.
# Never expose SUPABASE_SERVICE_ROLE_KEY to the frontend or commit real values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

AIMDS_HOST=0.0.0.0
AIMDS_PORT=8000
AIMDS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
AIMDS_SESSION_TTL_HOURS=24
AIMDS_TELEMETRY_INGEST_TOKEN=replace-with-a-long-random-device-token
AIMDS_TELEMETRY_HISTORY_LIMIT=500
# Twilio credentials stay server-side; never place them in frontend/.env.local.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
AIMDS_TWILIO_FROM_NUMBER=+15551234567
AIMDS_SMS_COOLDOWN_SECONDS=900
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Optional initial administrator bootstrap credentials (or create account via sign up)
AIMDS_ADMIN_EMAIL=admin@your-domain.com
AIMDS_ADMIN_PASSWORD=your-secure-admin-password

